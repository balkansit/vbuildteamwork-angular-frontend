.loading-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
}

.spinner-wrapper .mat-progress-spinner circle {
    stroke: var(--spinner-color) !important;
}

/* 🎯 This selector targets Angular Material’s spinner SVG circle */
.custom-spinner ::ng-deep .mat-mdc-progress-spinner .mdc-circular-progress__indeterminate-circle-graphic {
    stroke: var(--spinner-color) !important;
}

.loading-message {
    margin-top: 10px;
    font-size: 14px;
    color: #555;
}
